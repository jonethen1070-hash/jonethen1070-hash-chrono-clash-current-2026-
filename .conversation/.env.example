# Local and first public deploy. Guest stays on until a stable HTTPS origin
# exists and you later add that origin in Google Console (do not do that yet).
# Do not put a Google Client Secret here. The browser only uses the public Web client ID.
CHRONO_AUTH_MODE=development
CHRONO_ALLOW_GUEST=1
CHRONO_ALLOW_DEV_AUTH=0
GOOGLE_CLIENT_ID=397661440640-rlaj9s1k3orv17fu5vn8fknls1gakt09.apps.googleusercontent.com
# Set GOOGLE_REDIRECT_URI only after Render gives you a real https://*.onrender.com URL.
# GOOGLE_REDIRECT_URI=
PORT=8787
CHRONO_PORT=8787
CHRONO_STATIC_DIR=dist
CHRONO_DB=data/chrono.db
CHRONO_SESSION_TTL_MS=2592000000
CHRONO_MAX_SESSIONS=8
